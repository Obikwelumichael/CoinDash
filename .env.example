# PostgreSQL: use either this single URL or the individual PG* variables supported by node-postgres.
DATABASE_URL=postgres://cryptodash:change-me@localhost:5432/cryptodash
# Set true only when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Brevo transactional email. EMAIL_FROM_EMAIL must be a sender verified in Brevo.
BREVO_API_KEY=xkeysib-replace-with-your-brevo-api-key
EMAIL_FROM_NAME=CoinDash
EMAIL_FROM_EMAIL=your-verified-sender@example.com

# Existing market-data keys
COINGECKO_API_KEY=
FREECRYPTO_API_KEY=

# Optional for maintenance/test processes. Normal application runtime should leave this unset.
ALERT_SCHEDULER_DISABLED=false
# Evaluation cadence in milliseconds. Values below 15000 fall back to 60000.
ALERT_EVALUATION_INTERVAL_MS=60000
# Balanced automatic-feed defaults. Omit these values to use the same defaults.
MARKET_FEED_PRICE_WINDOW_MINUTES=5
MARKET_FEED_PRICE_THRESHOLD_PERCENT=1.5
MARKET_FEED_MAJOR_PRICE_THRESHOLD_PERCENT=3
MARKET_FEED_VOLUME_MULTIPLIER=2
MARKET_FEED_MAJOR_VOLUME_MULTIPLIER=4
MARKET_FEED_BREAKOUT_LOOKBACK_MINUTES=60
MARKET_FEED_BREAKOUT_BUFFER_PERCENT=0.5
MARKET_FEED_MAJOR_BREAKOUT_PERCENT=1.5
MARKET_FEED_MAJOR_BREAKOUT_VOLUME_MULTIPLIER=2
MARKET_FEED_COOLDOWN_MINUTES=10
MARKET_FEED_EMERGENCY_COOLDOWN_MINUTES=2
MARKET_FEED_EVENT_TTL_MINUTES=20
MARKET_FEED_DELIVERY_RATE_WINDOW_MINUTES=10
MARKET_FEED_GLOBAL_DELIVERY_LIMIT=20
MARKET_FEED_USER_DELIVERY_LIMIT=5

# Telegram Bot API webhook and durable delivery worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKER_DISABLED=false
# Database-only expiry cleanup still runs when delivery is disabled. Minimum 10000; default 60000.
TELEGRAM_EXPIRY_CLEANUP_INTERVAL_MS=60000
# Generate a random secret and configure the same value with Telegram setWebhook.
# Server-to-server bearer token for /api/operations/* diagnostics (minimum 32 characters).
OPERATIONS_TOKEN=
